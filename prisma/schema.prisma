generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["private_app"]
}

enum InviteCodeType {
  TEST
  INVITE

  @@schema("private_app")
}

enum InviteStatus {
  UNUSED
  ACTIVE
  COMPLETED

  @@schema("private_app")
}

model InviteAccess {
  id                String         @id @default(uuid()) @db.Uuid
  codeHash          String         @unique
  codeType          InviteCodeType
  status            InviteStatus   @default(UNUSED)
  redeemedAt        DateTime?
  completedAt       DateTime?
  sessionTokenHash  String?
  sessionExpiresAt  DateTime?
  returnCount       Int            @default(0)
  secondVisitChoice String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("invite_access")
  @@schema("private_app")
}
