generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["private_app"]
}

enum InviteCodeType {
  TEST
  INVITE

  @@schema("private_app")
}

enum InviteStatus {
  UNUSED
  ACTIVE
  COMPLETED

  @@schema("private_app")
}

model InviteAccess {
  id                String         @id @default(uuid()) @db.Uuid
  codeHash          String         @unique
  codeType          InviteCodeType
  status            InviteStatus   @default(UNUSED)
  redeemedAt        DateTime?
  completedAt       DateTime?
  sessionTokenHash  String?
  sessionExpiresAt  DateTime?
  returnCount       Int            @default(0)
  secondVisitChoice String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  notifications     InviteNotification[]

  @@map("invite_access")
  @@schema("private_app")
}

enum InviteNotificationEvent {
  REDEEMED
  COMPLETED

  @@schema("private_app")
}

model InviteNotification {
  id          String                  @id @default(uuid()) @db.Uuid
  inviteId    String                  @db.Uuid
  invite      InviteAccess            @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  event       InviteNotificationEvent
  occurredAt  DateTime
  acceptedAt  DateTime?
  deadAt      DateTime?
  attempts    Int                     @default(0)
  firstAttemptAt DateTime?
  nextAttemptAt DateTime              @default(now())
  leaseUntil  DateTime?
  createdAt   DateTime                @default(now())

  @@unique([inviteId, event])
  @@index([acceptedAt, nextAttemptAt])
  @@map("invite_notification")
  @@schema("private_app")
}

model InviteRateLimit {
  key       String   @id
  attempts  Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("invite_rate_limit")
  @@schema("private_app")
}
